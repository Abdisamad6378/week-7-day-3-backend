  const response = await fetch("http://localhost:4000/api/auth/register", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ email, password, name }),
  });
  const data = await response.json();
  if (response.ok) { /* store token, redirect */ }
  else { /* show error */ }
};

Expected output: Submitting with valid data registers the user and stores the token. Submitting with mismatched passwords shows a client-side error. Submitting with a duplicate email shows the API error.
